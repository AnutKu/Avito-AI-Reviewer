# Скопируйте в .env и при необходимости поправьте. Единый файл для всего стека.

POSTGRES_USER=avito
POSTGRES_PASSWORD=avito
POSTGRES_DB=avito_ai_reviewer
POSTGRES_PORT=55432

API_PORT=8081
UI_PORT=8080
AI_REVIEWER_PORT=8010
TASKCREATER_PORT=8082

JWT_SECRET=dev-secret-change-me
SEED_ON_START=true

# Z.AI: https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=
ZAI_MODEL=glm-5.3-flash
ZAI_REASONING_EFFORT=low
ZAI_TIMEOUT_SECONDS=120

# Потолок снапшота решения. Читают ОБА сервиса (api собирает снапшот, ai-reviewer
# страхуется перед отправкой в модель) — значения обязаны совпадать, иначе хвост
# решения молча не доедет до модели.
MAX_SNAPSHOT_CHARS=120000

# AI-ревью выполняется в BackgroundTasks процесса api, отдельной очереди нет.
# Повторы транзиентного отказа провайдера и срок, после которого прогон,
# оставшийся в running, считается зависшим и переводится в failed.
AI_REVIEW_MAX_ATTEMPTS=2
AI_REVIEW_RETRY_DELAY_SECONDS=3
AI_REVIEW_STALE_AFTER_SECONDS=600

# Детекция признаков AI. Индекс 0–100 считает api детерминированной функцией
# (api/app/services/detection_scale.py), модель только перечисляет наблюдаемые
# признаки с цитатами. С этого порога интерфейс ПРЕДЛАГАЕТ блиц-опрос — на балл
# индекс не влияет никогда.
DETECTION_BLITZ_THRESHOLD=70
# Переопределение весов признаков, JSON. Пусто — веса из справочника в коде.
# Пример калибровки под курс: {"unused_scaffolding": 18, "generic_naming": 4}
DETECTION_WEIGHTS={}

# Фиче-флаги: выключенный раздел не появляется в навигации.
FEATURE_DISTRIBUTION=true
FEATURE_RUBRIC_BUILDER=true
FEATURE_ANALYTICS=true
FEATURE_BLITZ=true
FEATURE_AI_DETECTION=true
FEATURE_COURSE_DEBT=false
FEATURE_TELEGRAM=false

# --- AI-помощник лектора (task-creater) ---
# 1 — детерминированные ответы без вызовов LLM (по умолчанию, работает из коробки).
# 0 + креды ниже — реальные прогоны через OpenAI-совместимый шлюз.
TASKCREATER_LLM_FAKE=1
# TASKCREATER_LLM_API_BASE=https://api.vsellm.ru/v1
# TASKCREATER_LLM_API_KEY=sk-...
# TASKCREATER_MODEL_FAST=google/gemini-3.5-flash-lite
# TASKCREATER_MODEL_SMART=google/gemini-3.6-flash
# TASKCREATER_RUB_PER_USD=90
#
# Проверенные рабочие модели на vsellm.ru: google/gemini-3.5-flash-lite,
#   google/gemini-3.5-flash, google/gemini-3.6-flash, google/gemini-2.5-flash,
#   anthropic/claude-haiku-4.5, qwen/qwen3.5-flash.
# Не работают (BadRequest): google/gemini-3.7-flash, openai/gpt-oss-120b.
#
# Родной провайдер вместо шлюза (ключ читает сам litellm):
# ANTHROPIC_API_KEY=sk-ant-...  + TASKCREATER_MODEL_SMART=anthropic/claude-sonnet-5

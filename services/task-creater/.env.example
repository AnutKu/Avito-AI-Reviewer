# Скопируйте в .env и заполните. Пусто = значение по умолчанию.
# Переменные читаются с префиксом TASKCREATER_ (см. app/config.py).

# --- Хранилище (для локального запуска без docker-compose) ---
# TASKCREATER_DATABASE_URL=postgresql+asyncpg://taskcreater:taskcreater@localhost:5433/taskcreater

# --- LLM: вариант 1 — OpenAI-совместимый шлюз (рекомендуется, дёшево) ---
# TASKCREATER_LLM_API_BASE=https://api.vsellm.ru/v1
# TASKCREATER_LLM_API_KEY=sk-...
# TASKCREATER_MODEL_FAST=google/gemini-3.5-flash-lite
# TASKCREATER_MODEL_SMART=google/gemini-3.6-flash
# Проверенные рабочие на vsellm.ru: google/gemini-3.5-flash-lite, google/gemini-3.5-flash,
#   google/gemini-3.6-flash, google/gemini-2.5-flash, anthropic/claude-haiku-4.5, qwen/qwen3.5-flash.
# Не работает на vsellm.ru (BadRequest): google/gemini-3.7-flash, openai/gpt-oss-120b.

# --- LLM: вариант 2 — родной провайдер (ключ читает сам litellm) ---
# ANTHROPIC_API_KEY=sk-ant-...
# TASKCREATER_MODEL_FAST=anthropic/claude-haiku-4-5-20251001
# TASKCREATER_MODEL_SMART=anthropic/claude-sonnet-5
# OPENAI_API_KEY=sk-...

# --- Оффлайн-режим: 1 — работать без вызовов LLM (детерминированные ответы) ---
TASKCREATER_LLM_FAKE=0

# --- Прочее ---
TASKCREATER_RUB_PER_USD=90

# --- Наблюдаемость (опционально) ---
# TASKCREATER_LANGFUSE_PUBLIC_KEY=pk-lf-...
# TASKCREATER_LANGFUSE_SECRET_KEY=sk-lf-...
# TASKCREATER_LANGFUSE_HOST=http://localhost:3000
